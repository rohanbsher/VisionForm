{
  "expo": {
    "name": "VisionForm",
    "slug": "VisionForm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "VisionForm needs camera access to analyze your workout form in real-time using AI pose detection.",
          "enableCodeScanner": false
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rohanbsher.visionform",
      "infoPlist": {
        "NSCameraUsageDescription": "VisionForm needs camera access to analyze your workout form in real-time using AI pose detection.",
        "NSPhotoLibraryUsageDescription": "VisionForm may save workout session snapshots for your reference."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
